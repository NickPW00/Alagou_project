# Copie para .env.local e ajuste. NUNCA coloque segredos neste arquivo de exemplo.

# Fonte de dados:
#   demo  -> dados FICTÍCIOS em memória, com faixa "MODO DEMONSTRAÇÃO" sempre visível (Fase 2)
#   none  -> sem backend configurado; telas mostram estados vazios (padrão)
#   (supabase será adicionado na Fase 3)
VITE_DATA_MODE=demo

# Estilo do mapa base (MapLibre). Padrão: OpenFreeMap (dados © OpenStreetMap).
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
